{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "make_dead_on_current_spawner_ownership_changed_from_buff_ownership": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "restart_existing_buff"
    },
    "stacking_ownership_type": "per_source_ability",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_id": "thes_starbase_planet_level_apply_hull_bonus"
            }]
        }
    },
    {
        "trigger_event_type": "on_current_spawner_planet_track_completed",
        "action_group":
        {
            "actions": [
            {
                "action_id": "thes_starbase_planet_level_apply_hull_bonus"
            }]
        }
    }]
}
